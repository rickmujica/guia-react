{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // Los ejemplos de la guía de TypeScript declaran cosas solo para mostrar su tipo.
      "files": ["src/demos/typescript/ejemplos/**"],
      "rules": {
        "no-unused-vars": "off",
        "no-unused-expressions": "off",
        "react/only-export-components": "off"
      }
    },
    {
      // Las demos de Animated usan el patrón clásico useRef(new Animated.Value(0)).current.
      // En la app real existe useAnimatedValue(), pero react-native-web (donde corren en la guía) no lo tiene.
      "files": ["app-expo/src/demos/interaccion/**"],
      "rules": {
        "react/refs": "off"
      }
    }
  ]
}
