{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Copia de expo/tsconfig.base (SDK 58). Está acá y no como \"extends\": \"expo/tsconfig.base\" para que la guía (Vite, en la raíz) pueda leer los archivos de app-expo sin instalar sus dependencias. Al actualizar el SDK, copiala de nuevo desde node_modules/expo/tsconfig.base.json.",
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "customConditions": [
      "react-native"
    ],
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext"
  },
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/babel.config.js",
    "${configDir}/metro.config.js",
    "${configDir}/jest.config.js",
    "${configDir}/android",
    "${configDir}/ios"
  ]
}
